@startuml
skinparam classAttributeIconSize 0

abstract class Product {
    - {static} productCount : int
    - id : int
    - name : String
    - price : double
    - stock : int
    + Product(id : int, name : String, price : double, stock : int)
    + getId() : int
    + getName() : String
    + getPrice() : double
    + getStock() : int
    + compareTo(other : Product) : int
    + {abstract} getDescription() : String
}

class ElectronicProduct {
    - warrantyMonths : int
    + ElectronicProduct(id : int, name : String, price : double, stock : int, warrantyMonths : int)
    + getWarrantyMonths() : int
    + getDescription() : String
}

class FoodProduct {
    - shelfLifeDays : int
    + FoodProduct(id : int, name : String, price : double, stock : int, shelfLifeDays : int)
    + getShelfLifeDays() : int
    + getDescription() : String
}

class InvalidProductException <<Exception>> {
    + InvalidProductException(message : String)
}

interface ProductSortStrategy {
    + sort(products : List<Product>) : void
}

class PriceSortStrategy {
    + sort(products : List<Product>) : void
}

class NameSortStrategy {
    + sort(products : List<Product>) : void
}

class ProductCatalog {
    - products : ArrayList<Product>
    - sortStrategy : ProductSortStrategy
    + setSortStrategy(sortStrategy : ProductSortStrategy) : void
    + addProduct(product : Product) : void
    + sortProducts() : void
    + findProduct(id : int) : Product
    + findProduct(name : String) : Product
    + calculateTotalValue() : double
}

class FileStorage {
    + saveToFile(products : ArrayList<Product>, fileName : String) : void
    + loadFromFile(fileName : String) : ArrayList<Product>
}

class ConsoleApp {
    + {static} main(args : String[]) : void
}

Product <|-- ElectronicProduct
Product <|-- FoodProduct
ProductSortStrategy <|.. PriceSortStrategy
ProductSortStrategy <|.. NameSortStrategy
ProductCatalog "1" o-- "0..*" Product
ProductCatalog "1" --> "1" ProductSortStrategy
ConsoleApp --> ProductCatalog
ConsoleApp --> FileStorage
@enduml
